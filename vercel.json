{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": { "api/pbs.ts": { "maxDuration": 60 } },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json" }] }
  ],
  "crons": [{ "path": "/api/jobs/academy", "schedule": "30 3 * * *" }],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    {
      "source": "/api/:path(.*)",
      "destination": "/api/pbs?__pbs_route=:path"
    },
    {
      "source": "/portfolio/:id",
      "destination": "/index.html"
    },
    {
      "source": "/verify/certificate/:token",
      "destination": "/index.html"
    },
    {
      "source": "/explore",
      "destination": "/index.html"
    },
    {
      "source": "/courses/:id",
      "destination": "/index.html"
    }
  ]
}
