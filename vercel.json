{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/jobs/academy", "schedule": "30 3 * * *" }],
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api/pbs?__pbs_route=:path"
    },
    {
      "source": "/portfolio/:id",
      "destination": "/index.html"
    },
    {
      "source": "/verify/certificate/:token",
      "destination": "/index.html"
    },
    {
      "source": "/explore",
      "destination": "/index.html"
    },
    {
      "source": "/courses/:id",
      "destination": "/index.html"
    }
  ]
}
