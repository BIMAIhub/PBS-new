PORT=3000
PBS_HOST=127.0.0.1
PBS_DATA_DIR=./data

# Set the public HTTPS origin on the host used for deployment.
PBS_PUBLIC_ORIGIN=
PBS_TRUST_PROXY=0

# Optional first-run administrator. Set both values on the server.
PBS_BOOTSTRAP_ADMIN_EMAIL=
PBS_BOOTSTRAP_ADMIN_PASSWORD=
PBS_BOOTSTRAP_ADMIN_NAME=

# Set these on Vercel by connecting a Turso database and a private Blob store.
PBS_TURSO_DATABASE_URL=
PBS_TURSO_AUTH_TOKEN=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Set the verified PBS UPI payment destination to accept payment references.
PBS_PAYMENT_UPI_ID=
PBS_PAYMENT_NAME=Pragmatic BIM Solution

# Required for Microsoft connections. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable; changing it requires reconnecting Microsoft accounts.
PBS_INTEGRATION_KEY=

PBS_MAX_UPLOAD_MB=1024
GEMINI_API_KEY=
PBS_GEMINI_MODEL=gemini-2.5-flash
