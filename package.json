{
  "name": "pbs-student-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "npm run build:web && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs --production",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/academy.test.ts tests/experience.test.ts tests/branding.test.ts tests/live-classes.test.ts tests/admissions-feedback.test.ts tests/access-controls.test.ts tests/playback.test.ts tests/microsoft-content.test.ts tests/engagement.test.ts tests/documents.test.ts tests/learning-platform.test.ts tests/database-config.test.ts tests/upload-queue.test.ts tests/course-content.test.ts tests/mobile-app.test.ts tests/education.test.ts tests/certificate-sharing.test.ts tests/png-assets.test.ts tests/past-student-contacts.test.ts tests/mail-and-erasure.test.ts tests/enrollment-erasure.test.ts",
    "admin:setup": "node --import tsx scripts/admin-setup.ts",
    "video:add": "node scripts/add-video.mjs",
    "migrate:legacy": "node --import tsx scripts/import-legacy.ts",
    "build:web": "node --import tsx scripts/check-database.ts && vite build",
    "mail:check-domain": "node --import tsx scripts/check-mail-domain.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "@google/genai": "^2.4.0",
    "@libsql/client": "0.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.4",
    "@vercel/oidc": "^4.0.9",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-png": "6.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "24.x"
  }
}
